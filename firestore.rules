rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // RÈGLES EXISTANTES : CATALOGUE PRODUITS
    // =========================================================================
    match /products/{productId} {
      // Lecture publique autorisée pour tous (visiteurs et clients)
      allow read: if true;
      // Écriture réservée à l'application Admin
      // allow write: if request.auth != null && ... ; // Règle définie par l'Admin
    }

    // =========================================================================
    // NOUVELLES RÈGLES CLIENT : ADRESSES DE LIVRAISON (users/{uid}/addresses)
    // =========================================================================
    match /users/{userId}/addresses/{addressId} {
      // Un client authentifié gère exclusivement ses propres adresses
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // NOUVELLES RÈGLES CLIENT : COMMANDES (orders/{orderId})
    // =========================================================================
    match /orders/{orderId} {
      // 1. LECTURE : Le client peut lire uniquement ses propres commandes
      // (À COMPLÉTER avec la règle Admin/Livreur : || request.auth.token.role in ['admin', 'driver'])
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // 2. CRÉATION : Un client authentifié peut créer sa propre commande si :
      // - Son userId correspond à son identifiant Auth
      // - Le statut initial est obligatoirement 'pending'
      // - Les champs obligatoires sont présents
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.total is number
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0;

      // 3. MODIFICATION : Le client peut UNIQUEMENT annuler une commande 'pending'
      // Il ne peut modifier que status, statusHistory et updatedAt.
      // Il ne peut jamais modifier le prix, les articles ou le userId.
      // (À COMPLÉTER avec la règle Admin/Livreur pour l'avancement des statuts)
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.total == resource.data.total
                    && request.resource.data.items == resource.data.items
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt']);

      // 4. SUPPRESSION : Interdite côté client (préservation de l'historique comptable)
      allow delete: if false;
    }
  }
}
