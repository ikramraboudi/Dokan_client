rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions pour vérifier les rôles
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isDeliverer() {
      return isAuthenticated() && (
        request.auth.token.role in ['deliverer', 'driver'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['deliverer', 'driver', 'livreur'])
      );
    }

    // Produits : lecture publique, écriture autorisée
    match /products/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Profils utilisateurs : le rôle ne peut pas être modifié depuis une app client
    match /users/{uid} {
      allow read: if request.auth != null;

      // Inscription : soit l'admin crée le compte (ex. livreur), soit le compte lui-même à l'inscription
      allow create: if isAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.role in ['pending', 'client', 'deliverer', 'livreur']
      );

      // Modification : soit l'admin, soit l'utilisateur pour ses propres champs (hors rôle)
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );

      allow delete: if isAdmin();
    }

    // Commandes : gestion des accès pour les livreurs et autres rôles (compatibilité livreur)
    match /commandes/{commandeId} {
      // Un utilisateur connecté peut lire une commande si :
      // 1. Il est le livreur assigné à cette commande (livreurId == son UID)
      // 2. OU il est le client qui a passé la commande
      // 3. OU il est admin
      allow read: if request.auth != null && (
        resource.data.livreurId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );

      // Le livreur peut uniquement mettre à jour certaines données (ex: le statut de livraison)
      // sans pouvoir réassigner la commande à quelqu'un d'autre ou changer le client.
      allow update: if request.auth != null && (
        (resource.data.livreurId == request.auth.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['livreurId', 'clientId'])) ||
        isAdmin()
      );

      // La création et la suppression des commandes sont généralement gérées par l'admin ou le backend/app web
      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // NOUVELLES RÈGLES CLIENT : ADRESSES (users/{uid}/addresses)
    // =========================================================================
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // NOUVELLES RÈGLES CLIENT : COMMANDES (orders/{orderId})
    // =========================================================================
    match /orders/{orderId} {
      // 1. Lecture : client propriétaire OU admin OU livreur assigné
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin() ||
        resource.data.driverId == request.auth.uid ||
        resource.data.livreurId == request.auth.uid ||
        (resource.data.driver != null && resource.data.driver.id == request.auth.uid)
      );

      // 2. Création : client pour sa propre commande OU admin (simulation / gestion)
      allow create: if request.auth != null && (
        isAdmin() ||
        (
          (request.resource.data.userId == request.auth.uid || request.resource.data.customerId == request.auth.uid) &&
          request.resource.data.status in ['en attente', 'en_attente', 'pending', 'en cours', 'preparing'] &&
          request.resource.data.total is number &&
          request.resource.data.items is list &&
          request.resource.data.items.size() > 0
        )
      );

      // 3. Modification :
      // - Admin : confirmation, attribution livreur, changement de statut, annulation
      // - Livreur assigné : avancement de statut de livraison ('in_progress', 'delivered', 'failed', 'refused', 'enleve', 'livre', 'echec')
      // - Client : annulation si commande en attente ('en attente' -> 'annule')
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          isDeliverer() && (
            resource.data.driverId == request.auth.uid ||
            resource.data.livreurId == request.auth.uid ||
            (resource.data.driver != null && resource.data.driver.id == request.auth.uid)
          ) &&
          request.resource.data.status in ['in_progress', 'delivered', 'failed', 'refused', 'delivering', 'completed', 'en cours', 'enleve', 'livre', 'echec']
        ) ||
        (
          (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid) &&
          resource.data.status in ['en attente', 'en_attente', 'pending', 'preparing'] &&
          request.resource.data.status in ['annule', 'cancelled'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statut', 'statusHistory', 'updatedAt', 'cancelReason'])
        )
      );

      // 4. Suppression : réservée à l'administrateur
      allow delete: if isAdmin();
    }

    // =========================================================================
    // NOUVELLES RÈGLES : COUPONS PROMOTIONNELS (coupons/{couponId})
    // =========================================================================
    match /coupons/{couponId} {
      // 1. Lecture : tout utilisateur connecté peut consulter/vérifier les coupons
      allow read: if request.auth != null;

      // 2. Création et suppression : strictement réservées à l'administrateur
      allow create, delete: if isAdmin();

      // 3. Mise à jour :
      // - Admin a tous les droits
      // - Client connecté peut uniquement enregistrer son utilisation
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentUsageCount', 'usedByUsers', 'updatedAt'])
      );
    }

    // =========================================================================
    // NOUVELLES RÈGLES : RÉGIONS DE LIVRAISON (regions/{regionId})
    // =========================================================================
    match /regions/{regionId} {
      // 1. Lecture : tout utilisateur connecté (pour auto-dispatch et adresses)
      allow read: if request.auth != null;

      // 2. Écriture : réservée exclusivement à l'administrateur
      allow write: if isAdmin();
    }

    // =========================================================================
    // NOUVELLES RÈGLES : PARC VÉHICULES (vehicules/{vehicleId})
    // =========================================================================
    match /vehicules/{vehicleId} {
      // 1. Lecture : tout utilisateur connecté
      allow read: if request.auth != null;

      // 2. Écriture : réservée exclusivement à l'administrateur
      allow write: if isAdmin();
    }

    // =========================================================================
    // NOUVELLES RÈGLES CLIENT : AVIS POST-LIVRAISON (reviews/{orderId}_{productId})
    // =========================================================================
    match /reviews/{reviewId} {
      // 1. LECTURE PUBLIQUE : Visiteurs et clients peuvent lire tous les avis
      allow read: if true;

      // 2. CRÉATION : Réservée au client auteur pour un produit d'une commande livrée (ou admin)
      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid
          && reviewId == (request.resource.data.orderId + '_' + request.resource.data.productId)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.keys().hasOnly([
               'productId', 'orderId', 'userId', 'authorName',
               'rating', 'comment', 'createdAt', 'updatedAt'
             ])
          && (
            !exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
            || (
              (
                get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
                || get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
                || get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.clientId == request.auth.uid
              )
              && (
                get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ['livre', 'livree', 'delivered']
                || get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.statut in ['livre', 'livree', 'delivered']
              )
            )
          )
        )
      );

      // 3. MODIFICATION : Seul l'auteur peut modifier son avis (ou admin)
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt', 'authorName'])
        )
      );

      // 4. SUPPRESSION : L'auteur de l'avis OU l'administrateur (modération)
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

  }
}
